Calendar = CALENDAR(DATE(2024,1,1), DATE(2026,12,31))

Month Key = FORMAT('Calendar'[Date], "YYYY-MM")
Month = FORMAT('Calendar'[Date], "MMM YYYY")

New Leads = SUM(crm_monthly[New Leads])
Lead Target = SUM(crm_monthly[Lead Target])
Qualified Leads = SUM(crm_monthly[Qualified Leads])
Opportunities = SUM(crm_monthly[Opportunities])
Won Deals = SUM(crm_monthly[Won Deals])
Won Revenue = SUM(crm_monthly[Won Revenue])
Revenue Target = SUM(crm_monthly[Revenue Target])
Pipeline Value = SUM(crm_monthly[Pipeline Value])
Average Deal Size = DIVIDE([Won Revenue],[Won Deals])
Lead Qualification Rate = DIVIDE([Qualified Leads],[New Leads])
Opportunity Conversion = DIVIDE([Opportunities],[Qualified Leads])
Win Rate = DIVIDE([Won Deals],[Opportunities])
Target Attainment = DIVIDE([Won Revenue],[Revenue Target])
Sales Cycle Days = AVERAGE(crm_monthly[Sales Cycle Days])
New Leads PY = CALCULATE([New Leads],DATEADD('Calendar'[Date],-1,YEAR))
Won Revenue PY = CALCULATE([Won Revenue],DATEADD('Calendar'[Date],-1,YEAR))
Leads YoY % = DIVIDE([New Leads]-[New Leads PY],[New Leads PY])
Revenue YoY % = DIVIDE([Won Revenue]-[Won Revenue PY],[Won Revenue PY])
Revenue Variance = [Won Revenue]-[Revenue Target]
Revenue Variance % = DIVIDE([Revenue Variance],[Revenue Target])